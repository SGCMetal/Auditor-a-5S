{
  "functions": [{ "source": "functions", "codebase": "default" }],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "package.json",
      "functions/**",
      ".gitignore",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
